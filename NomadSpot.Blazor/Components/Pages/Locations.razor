@page "/locations"
@rendermode InteractiveServer
@using NomadSpot.ViewModel
@using NomadSpot.Model.Entities
@using System.Reflection

<h3>Find Locations</h3>

<div class="mb-3">
    <label class="form-label">Your location:</label>
    <div class="d-flex gap-3 mb-2">
        <div>
            <label class="form-label mb-0">Latitude</label>
            <input type="number" step="0.00001" class="form-control"
                   @bind="ViewModel.UserLatitude" @bind:event="oninput"/>
        </div>
        <div>
            <label class="form-label mb-0">Longitude</label>
            <input type="number" step="0.00001" class="form-control"
                   @bind="ViewModel.UserLongitude" @bind:event="oninput"/>
        </div>
    </div>
    <MapPicker Lat="ViewModel.UserLatitude" Lng="ViewModel.UserLongitude"
               OnCoordinatesSelected="coords => { ViewModel.UserLatitude = coords.Lat; ViewModel.UserLongitude = coords.Lng; StateHasChanged(); }"/>
</div>

<div class="mb-3">
    <label>Type:</label>
    <select class="form-control" @bind="ViewModel.SearchTypeIndex">
        <option value="0">Indoor</option>
        <option value="1">Outdoor</option>
    </select>
</div>

<div class="mb-3">
    <label>Results:</label>
    <input type="number" @bind="ViewModel.ResultCount" class="form-control"/>
</div>

<button class="btn btn-primary me-2"   @onclick="() => { ViewModel.FindLocationsCommand.Execute(null); ShowFilters = false; }">Find Closest</button>
<button class="btn btn-secondary me-2" @onclick="() => ShowFilters = !ShowFilters">Search with Filters</button>
<button class="btn btn-outline-danger" @onclick="() => { ViewModel.ClearResultsCommand.Execute(null); ShowReview = false; ShowReviews = false; ShowReviewFilters = false; }">Clear Results</button>

@if (ShowFilters)
{
    <div class="card mt-3 p-3">
        <h5>Filters</h5>
        @foreach (var filter in ViewModel.CurrentFilter.FilterProperties)
        {
            <div class="mb-2">
                <label>@filter.DisplayName</label>
                @if (filter.PropertyType == typeof(bool) || filter.PropertyType == typeof(bool?))
                {
                    <input type="checkbox" class="ms-2"
                           @bind:get="(bool)(filter.Value ?? false)"
                           @bind:set="v => filter.Value = v"/>
                }
                else if (filter.PropertyType.IsEnum)
                {
                    <select class="form-select"
                            @bind:get="filter.Value?.ToString() ?? string.Empty"
                            @bind:set="v => filter.Value = string.IsNullOrEmpty(v) ? null : (object)(int)Enum.Parse(filter.PropertyType, v)">
                        <option value="">(Any)</option>
                        @foreach (var name in filter.EnumValues)
                        {
                            <option value="@name">@name</option>
                        }
                    </select>
                }
                else if (filter.IsSlider)
                {
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <span class="text-muted small">Min:</span>
                        <input type="range" min="@filter.Min" max="@filter.Max" step="1"
                               class="form-range" style="width:140px"
                               @bind="filter.MinValue" @bind:event="oninput"/>
                        <span>@filter.MinValue</span>
                        <span class="text-muted small ms-2">Max:</span>
                        <input type="range" min="@filter.Min" max="@filter.Max" step="1"
                               class="form-range" style="width:140px"
                               @bind="filter.MaxValue" @bind:event="oninput"/>
                        <span>@filter.MaxValue</span>
                        <button class="btn btn-sm btn-outline-secondary"
                                @onclick="() => { filter.MinValue = filter.Min; filter.MaxValue = filter.Max; }">Reset</button>
                    </div>
                }
                else if (filter.PropertyType == typeof(DateTime) || filter.PropertyType == typeof(DateTime?))
                {
                    <input type="date" class="form-control"
                           @bind:get="filter.Value is DateTime ? (DateTime)filter.Value : default(DateTime)"
                           @bind:set="v => filter.Value = v"/>
                }
                else
                {
                    <input type="text" class="form-control"
                           @bind:get="filter.Value?.ToString() ?? string.Empty"
                           @bind:set="v => filter.Value = string.IsNullOrEmpty(v) ? null : v"/>
                }
            </div>
        }
        <button class="btn btn-primary me-2"      @onclick="() => { ViewModel.FindWithFiltersCommand.Execute(null); ShowFilters = false; }">Apply</button>
        <button class="btn btn-outline-secondary" @onclick="() => ViewModel.ClearFiltersCommand.Execute(null)">Clear</button>
    </div>
}

@if (ViewModel.LocationList.Items.Any())
{
    <div class="mt-3">
        <h5>Results</h5>
        <div class="mb-2">
            <strong>Columns: </strong>
            @foreach (var col in AllColumns)
            {
                <label class="me-3">
                    <input type="checkbox" checked="@ViewModel.SelectedLocationColumns.Contains(col)"
                           @onchange="e => ViewModel.ToggleLocationColumn(col, (bool)e.Value)"/> @col
                </label>
            }
        </div>

        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    @foreach (var col in ViewModel.SelectedLocationColumns) { <th>@col</th> }
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var loc in ViewModel.LocationList.Items)
                {
                    <tr class="@(ViewModel.LocationList.SelectedItem == loc ? "table-primary" : "")"
                        @onclick="() => ViewModel.SelectLocation(loc)"
                        style="cursor:pointer">
                        @foreach (var col in ViewModel.SelectedLocationColumns)
                        {
                            <td>@loc.GetType().GetProperty(col)?.GetValue(loc)</td>
                        }
                        <td>
                            <button class="btn btn-sm btn-warning me-1"
                                    @onclick:stopPropagation="true"
                                    @onclick="() => ViewModel.MarkInactiveCommand.Execute(loc)">Inactive</button>
                            <button class="btn btn-sm btn-info me-1"
                                    @onclick:stopPropagation="true"
                                    @onclick="() => { ViewModel.OpenAddReviewCommand.Execute(loc); ShowReview = true; }">Review</button>
                            <button class="btn btn-sm btn-secondary"
                                    @onclick:stopPropagation="true"
                                    @onclick="() => { ViewModel.ViewReviewsCommand.Execute(loc); ShowReviews = true; ShowReview = false; }">View Reviews</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (ViewModel.LocationList.SelectedItem != null && !ShowReview)
{
    <div class="card mt-3 p-3">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h5 class="mb-0">@ViewModel.LocationList.SelectedItem.Name</h5>
            <button class="btn btn-sm btn-outline-secondary"
                    @onclick="() => ViewModel.SelectLocation(null)">&times; Close</button>
        </div>
        <div class="row">
            @foreach (var prop in ViewModel.LocationList.SelectedItem.GetType().GetProperties(BindingFlags.Public | BindingFlags.Instance))
            {
                var val = prop.GetValue(ViewModel.LocationList.SelectedItem);
                <div class="col-md-4 mb-1">
                    <small class="text-muted">@prop.Name</small><br/>
                    <strong>@(val ?? "-")</strong>
                </div>
            }
        </div>
    </div>
}

@if (ShowReviews && ViewModel.LocationList.SelectedItem != null)
{
    <div class="card mt-3 p-3">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="mb-0">Reviews for @ViewModel.LocationList.SelectedItem.Name</h5>
            <div>
                <button class="btn btn-sm btn-outline-primary me-2"
                        @onclick="() => ShowReviewFilters = !ShowReviewFilters">Filter</button>
                <button class="btn btn-sm btn-outline-secondary"
                        @onclick="() => { ShowReviews = false; ShowReviewFilters = false; ViewModel.ReviewFilter.ClearCommand.Execute(null); }">&times; Close</button>
            </div>
        </div>

        @if (ShowReviewFilters)
        {
            <div class="card p-2 mb-3">
                @foreach (var filter in ViewModel.ReviewFilter.FilterProperties)
                {
                    <div class="mb-2">
                        <label>@filter.DisplayName</label>
                        @if (filter.PropertyType == typeof(bool) || filter.PropertyType == typeof(bool?))
                        {
                            <input type="checkbox" class="ms-2"
                                   @bind:get="(bool)(filter.Value ?? false)"
                                   @bind:set="v => filter.Value = v"/>
                        }
                        else if (filter.IsSlider)
                        {
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <span class="text-muted small">Min:</span>
                                <input type="range" min="@filter.Min" max="@filter.Max" step="1"
                                       class="form-range" style="width:120px"
                                       @bind="filter.MinValue" @bind:event="oninput"/>
                                <span>@filter.MinValue</span>
                                <span class="text-muted small ms-2">Max:</span>
                                <input type="range" min="@filter.Min" max="@filter.Max" step="1"
                                       class="form-range" style="width:120px"
                                       @bind="filter.MaxValue" @bind:event="oninput"/>
                                <span>@filter.MaxValue</span>
                            </div>
                        }
                        else
                        {
                            <input type="text" class="form-control"
                                   @bind:get="filter.Value?.ToString() ?? string.Empty"
                                   @bind:set="v => filter.Value = string.IsNullOrEmpty(v) ? null : v"/>
                        }
                    </div>
                }
                <button class="btn btn-sm btn-outline-secondary"
                        @onclick="() => ViewModel.ReviewFilter.ClearCommand.Execute(null)">Clear</button>
            </div>
        }

        @if (!ViewModel.ReviewList.Items.Any())
        {
            <p class="text-muted">No reviews yet.</p>
        }
        else
        {
            <div class="mb-2">
                <strong>Columns: </strong>
                @foreach (var col in ViewModel.FilteredReviewColumns)
                {
                    <label class="me-3">
                        <input type="checkbox" checked="@ViewModel.SelectedReviewColumns.Contains(col)"
                               @onchange="e => ViewModel.ToggleReviewColumn(col, (bool)e.Value)"/> @col
                    </label>
                }
            </div>

            <table class="table table-striped table-sm">
                <thead>
                    <tr>
                        @foreach (var col in ViewModel.SelectedReviewColumns) { <th>@col</th> }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var review in ViewModel.GetFilteredReviews())
                    {
                        <tr>
                            @foreach (var col in ViewModel.SelectedReviewColumns)
                            {
                                <td>@review.GetType().GetProperty(col)?.GetValue(review)</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
}

@if (ShowReview && ViewModel.LocationList.SelectedItem != null)
{
    <div class="card mt-3 p-3">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h5 class="mb-0">Add Review for @ViewModel.LocationList.SelectedItem.Name</h5>
            <button class="btn btn-sm btn-outline-secondary"
                    @onclick="() => ShowReview = false">&times; Close</button>
        </div>
        <div class="mb-2">
            <label>Author:</label>
            <input type="text" @bind="ViewModel.NewReviewAuthor" class="form-control"/>
        </div>
        <div class="mb-2">
            <label>Rating (1-5): <strong>@ViewModel.NewReviewRating</strong></label>
            <input type="range" min="1" max="5" step="1"
                   @bind="ViewModel.NewReviewRating" class="form-range"/>
        </div>
        <div class="mb-2">
            <label>Noise Level (1-5): <strong>@ViewModel.NewReviewNoiseLevel</strong></label>
            <input type="range" min="1" max="5" step="1"
                   @bind="ViewModel.NewReviewNoiseLevel" class="form-range"/>
        </div>
        <div class="mb-2">
            <label>WiFi Strength (0-5): <strong>@ViewModel.NewReviewWifiStrength</strong></label>
            <input type="range" min="0" max="5" step="1"
                   @bind="ViewModel.NewReviewWifiStrength" class="form-range"/>
            <small class="text-muted">0 = No WiFi</small>
        </div>
        @if (ViewModel.IsSelectedLocationIndoor)
        {
            <div class="mb-2">
                <label>Comfort Level (1-5): <strong>@ViewModel.NewReviewComfortLevel</strong></label>
                <input type="range" min="1" max="5" step="1"
                       @bind="ViewModel.NewReviewComfortLevel" class="form-range"/>
            </div>
            <div class="mb-2">
                <label>Price Level (1-5): <strong>@ViewModel.NewReviewPriceLevel</strong></label>
                <input type="range" min="1" max="5" step="1"
                       @bind="ViewModel.NewReviewPriceLevel" class="form-range"/>
            </div>
        }
        else
        {
            <div class="mb-2">
                <label>Cleanliness (1-5): <strong>@ViewModel.NewReviewCleanliness</strong></label>
                <input type="range" min="1" max="5" step="1"
                       @bind="ViewModel.NewReviewCleanliness" class="form-range"/>
            </div>
            <div class="mb-2">
                <label>Crowdedness (1-5): <strong>@ViewModel.NewReviewCrowdedness</strong></label>
                <input type="range" min="1" max="5" step="1"
                       @bind="ViewModel.NewReviewCrowdedness" class="form-range"/>
            </div>
        }
        <div class="mb-2">
            <label>Comment:</label>
            <textarea @bind="ViewModel.NewReviewComment" class="form-control" rows="3"></textarea>
        </div>
        <button class="btn btn-success" @onclick="() => { ViewModel.SaveNewReviewCommand.Execute(null); ShowReview = false; }">Submit Review</button>
    </div>
}

@if (!string.IsNullOrEmpty(ViewModel.StatusMessage))
{
    <div class="alert alert-success mt-3">@ViewModel.StatusMessage</div>
}

@code {
    [Inject] LocationViewModel ViewModel { get; set; }

    bool ShowFilters       { get; set; }
    bool ShowReview        { get; set; }
    bool ShowReviews       { get; set; }
    bool ShowReviewFilters { get; set; }

    List<string> AllColumns => ViewModel.LocationList.GetAllColumnNames().ToList();
}
