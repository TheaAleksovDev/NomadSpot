@page "/settings"
@rendermode InteractiveServer
@using NomadSpot.Blazor.Services
@using NomadSpot.Model.Database
@inject DatabaseSettingsService DbSettings
@inject NavigationManager Nav

<h3>Settings</h3>

<div class="mb-3">
    <label class="form-label fw-bold">Database:</label>
    <div>
        <div class="form-check">
            <input class="form-check-input" type="radio" id="pg" name="db"
                   checked="@(DbSettings.DbType == DatabaseType.PostgreSQL)"
                   @onchange="() => SelectDb(DatabaseType.PostgreSQL)"/>
            <label class="form-check-label" for="pg">PostgreSQL</label>
        </div>
        <div class="form-check">
            <input class="form-check-input" type="radio" id="sqlite" name="db"
                   checked="@(DbSettings.DbType == DatabaseType.SQLite)"
                   @onchange="() => SelectDb(DatabaseType.SQLite)"/>
            <label class="form-check-label" for="sqlite">SQLite</label>
        </div>
    </div>
</div>

<p class="text-muted">Current: <strong>@DbSettings.DbType</strong></p>

@code {
    void SelectDb(DatabaseType type)
    {
        DbSettings.DbType = type;
        Nav.NavigateTo("/locations", forceLoad: true);
    }
}
