@page "/add-location"
@rendermode InteractiveServer
@using NomadSpot.ViewModel
@using NomadSpot.Model.Entities

<h3>Add New Location</h3>

<div class="mb-3">
    <label>Name:</label>
    <input type="text" @bind="Name" class="form-control" />
</div>

<div class="mb-3">
    <label>Address:</label>
    <input type="text" @bind="Address" class="form-control" />
</div>

<div class="mb-3">
    <label>Latitude:</label>
    <input type="number" @bind="Latitude" class="form-control" step="0.0001" />
</div>

<div class="mb-3">
    <label>Longitude:</label>
    <input type="number" @bind="Longitude" class="form-control" step="0.0001" />
</div>

<div class="mb-3">
    <label>Type:</label>
    <select class="form-control" @onchange="OnTypeChanged">
        <option value="indoor">Indoor</option>
        <option value="outdoor">Outdoor</option>
    </select>
</div>

<div class="mb-3">
    <label>Noise Level (1-5):</label>
    <input type="number" @bind="NoiseLevel" min="1" max="5" class="form-control" />
</div>

<div class="mb-3">
    <input type="checkbox" @bind="HasWifi" /> Has WiFi
</div>

<div class="mb-3">
    <input type="checkbox" @bind="HasPowerOutlets" /> Has Power Outlets
</div>

@if (!IsIndoor)
{
    <div class="mb-3">
        <input type="checkbox" @bind="HasBenches" /> Has Benches
    </div>
    <div class="mb-3">
        <input type="checkbox" @bind="HasShade" /> Has Shade
    </div>
    <div class="mb-3">
        <input type="checkbox" @bind="PetFriendly" /> Pet Friendly
    </div>
    <div class="mb-3">
        <input type="checkbox" @bind="HasPublicToilet" /> Has Public Toilet
    </div>
    <div class="mb-3">
        <input type="checkbox" @bind="NearShops" /> Near Shops
    </div>
}

@if (IsIndoor)
{
    <div class="mb-3">
        <label>Comfort Level (1-5):</label>
        <input type="number" @bind="ComfortLevel" min="1" max="5" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Price Level (1-5):</label>
        <input type="number" @bind="PriceLevel" min="1" max="5" class="form-control" />
    </div>
}

<button class="btn btn-primary" @onclick="Add">Add Location</button>

@if (!string.IsNullOrEmpty(Message))
{
    <div class="alert alert-success mt-3">@Message</div>
}

@code {
    [Inject] LocationViewModel ViewModel { get; set; }

    string Name { get; set; }
    string Address { get; set; }
    double Latitude { get; set; }
    double Longitude { get; set; }
    bool IsIndoor { get; set; } = true;
    int NoiseLevel { get; set; } = 1;
    bool HasWifi { get; set; }
    bool HasPowerOutlets { get; set; }
    bool HasBenches { get; set; }
    bool HasShade { get; set; }
    bool PetFriendly { get; set; }
    bool HasPublicToilet { get; set; }
    bool NearShops { get; set; }
    int ComfortLevel { get; set; } = 1;
    int PriceLevel { get; set; } = 1;
    string Message { get; set; }

    void OnTypeChanged(ChangeEventArgs e)
    {
        IsIndoor = e.Value.ToString() == "indoor";
    }

    void Add()
    {
        if (string.IsNullOrWhiteSpace(Name))
        {
            Message = "Please enter a name.";
            return;
        }

        Location location;
        if (IsIndoor)
        {
            location = new IndoorLocation
            {
                Name = Name,
                Address = Address,
                Latitude = Latitude,
                Longitude = Longitude,
                NoiseLevel = NoiseLevel,
                HasWifi = HasWifi,
                HasPowerOutlets = HasPowerOutlets,
                LastVerified = DateTime.Now,
                IsActive = true,
                LocationType = "Indoor",
                ComfortLevel = ComfortLevel,
                PriceLevel = PriceLevel
            };
        }
        else
        {
            location = new OutdoorLocation
            {
                Name = Name,
                Address = Address,
                Latitude = Latitude,
                Longitude = Longitude,
                NoiseLevel = NoiseLevel,
                HasWifi = HasWifi,
                HasPowerOutlets = HasPowerOutlets,
                LastVerified = DateTime.Now,
                IsActive = true,
                LocationType = "Outdoor",
                HasBenches = HasBenches,
                HasShade = HasShade,
                PetFriendly = PetFriendly,
                HasPublicToilet = HasPublicToilet,
                NearShops = NearShops
            };
        }

        ViewModel.AddLocation(location);
        Message = "Location added successfully!";
    }
}