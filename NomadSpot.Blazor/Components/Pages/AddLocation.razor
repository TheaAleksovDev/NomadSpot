@page "/add-location"
@rendermode InteractiveServer
@using NomadSpot.ViewModel
@using NomadSpot.Model.Entities

<h3>Add New Location</h3>

<div class="mb-3">
    <label>Name:</label>
    <input type="text" @bind="ViewModel.NewName" class="form-control"/>
</div>

<div class="mb-3">
    <label>Address:</label>
    <input type="text" @bind="ViewModel.NewAddress" class="form-control"/>
</div>

<div class="mb-3">
    <label class="form-label">Location:</label>
    <div class="d-flex gap-3 mb-2">
        <div>
            <label class="form-label mb-0">Latitude</label>
            <input type="number" step="0.00001" class="form-control"
                   @bind="ViewModel.NewLatitude" @bind:event="oninput"/>
        </div>
        <div>
            <label class="form-label mb-0">Longitude</label>
            <input type="number" step="0.00001" class="form-control"
                   @bind="ViewModel.NewLongitude" @bind:event="oninput"/>
        </div>
    </div>
    <MapPicker Lat="ViewModel.NewLatitude" Lng="ViewModel.NewLongitude"
               OnCoordinatesSelected="coords => { ViewModel.NewLatitude = coords.Lat; ViewModel.NewLongitude = coords.Lng; StateHasChanged(); }"/>
</div>

<div class="mb-3">
    <label>Type:</label>
    <select class="form-control" @bind="ViewModel.NewLocationTypeIndex">
        <option value="0">Indoor</option>
        <option value="1">Outdoor</option>
    </select>
</div>

<div class="mb-3">
    <label>Noise Level: <strong>@ViewModel.NewNoiseLevel</strong></label>
    <input type="range" min="1" max="5" step="1" @bind="ViewModel.NewNoiseLevel" class="form-range"/>
</div>

<div class="mb-3">
    <label>WiFi Strength: <strong>@ViewModel.NewWifiStrength</strong></label>
    <input type="range" min="0" max="5" step="1" @bind="ViewModel.NewWifiStrength" class="form-range"/>
    <small class="text-muted">0 = No WiFi</small>
</div>

<div class="mb-3">
    <input type="checkbox" @bind="ViewModel.NewHasPowerOutlets"/> Has Power Outlets
</div>

@if (ViewModel.NewIsOutdoor)
{
    <div class="mb-3">
        <label>Outdoor Type:</label>
        <select class="form-control" @bind="ViewModel.NewOutdoorType">
            @foreach (var val in Enum.GetValues<OutdoorType>())
            {
                <option value="@val">@val</option>
            }
        </select>
    </div>
    <div class="mb-3">
        <input type="checkbox" @bind="ViewModel.NewHasBenches"/> Has Benches
    </div>
    <div class="mb-3">
        <input type="checkbox" @bind="ViewModel.NewHasShade"/> Has Shade
    </div>
    <div class="mb-3">
        <input type="checkbox" @bind="ViewModel.NewPetFriendly"/> Pet Friendly
    </div>
    <div class="mb-3">
        <input type="checkbox" @bind="ViewModel.NewHasPublicToilet"/> Has Public Toilet
    </div>
    <div class="mb-3">
        <input type="checkbox" @bind="ViewModel.NewNearShops"/> Near Shops
    </div>
}

@if (ViewModel.NewIsIndoor)
{
    <div class="mb-3">
        <label>Indoor Type:</label>
        <select class="form-control" @bind="ViewModel.NewIndoorType">
            @foreach (var val in Enum.GetValues<IndoorType>())
            {
                <option value="@val">@val</option>
            }
        </select>
    </div>
    <div class="mb-3">
        <label>Comfort Level: <strong>@ViewModel.NewComfortLevel</strong></label>
        <input type="range" min="1" max="5" step="1" @bind="ViewModel.NewComfortLevel" class="form-range"/>
    </div>
    <div class="mb-3">
        <label>Price Level: <strong>@ViewModel.NewPriceLevel</strong></label>
        <input type="range" min="1" max="5" step="1" @bind="ViewModel.NewPriceLevel" class="form-range"/>
    </div>
    <div class="mb-3">
        <label>Opening Hours:</label>
        <input type="text" @bind="ViewModel.NewOpeningHours" class="form-control" placeholder="e.g. 08:00-22:00"/>
    </div>
}

<button class="btn btn-primary"
        disabled="@(!ViewModel.SaveNewLocationCommand.CanExecute(null))"
        @onclick="() => ViewModel.SaveNewLocationCommand.Execute(null)">Add Location</button>

@if (!string.IsNullOrEmpty(ViewModel.StatusMessage))
{
    <div class="alert alert-success mt-3">@ViewModel.StatusMessage</div>
}

@code {
    [Inject] LocationViewModel ViewModel { get; set; }
}
