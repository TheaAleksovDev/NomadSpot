<Window x:Class="NomadSpot.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NomadSpot" Height="400" Width="500"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="NomadSpot" FontSize="24" 
                   FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Latitude:" Width="80" VerticalAlignment="Center"/>
            <TextBox x:Name="LatitudeBox" Width="150"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Longitude:" Width="80" VerticalAlignment="Center"/>
            <TextBox x:Name="LongitudeBox" Width="150"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Type:" Width="80" VerticalAlignment="Center"/>
            <ComboBox x:Name="LocationTypeBox" Width="150">
                <ComboBoxItem Content="Indoor" IsSelected="True"/>
                <ComboBoxItem Content="Outdoor"/>
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Results:" Width="80" VerticalAlignment="Center"/>
            <TextBox x:Name="ResultCountBox" Width="50" Text="3"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Vertical" VerticalAlignment="Bottom">
            <Button Content="Find Closest Locations" Margin="0,5" Padding="10,5" Click="FindLocations_Click"/>
            <Button Content="Search with Filters" Margin="0,5" Padding="10,5" Click="FilterLocations_Click"/>
            <Button Content="Add New Location" Margin="0,5" Padding="10,5" Click="AddLocation_Click"/>
        </StackPanel>
    </Grid>
</Window>