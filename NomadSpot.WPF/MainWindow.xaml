<Window x:Class="NomadSpot.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NomadSpot" Height="450" Width="500"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="NomadSpot" FontSize="24"
                   FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Database:" Width="80" VerticalAlignment="Center"/>
            <RadioButton x:Name="PgRadio" Content="PostgreSQL" IsChecked="True"
                         Margin="0,0,10,0" VerticalAlignment="Center" Checked="DB_Changed"/>
            <RadioButton x:Name="SqliteRadio" Content="SQLite"
                         VerticalAlignment="Center" Checked="DB_Changed"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Latitude:" Width="80" VerticalAlignment="Center"/>
            <TextBox Width="150" Text="{Binding UserLatitude, Mode=TwoWay}"/>
            <Button Content="Use My Location" Margin="10,0,0,0" Padding="8,3"
                    Command="{Binding UseMyLocationCommand}"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Longitude:" Width="80" VerticalAlignment="Center"/>
            <TextBox Width="150" Text="{Binding UserLongitude, Mode=TwoWay}"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Type:" Width="80" VerticalAlignment="Center"/>
            <ComboBox Width="150" SelectedIndex="{Binding SearchTypeIndex, Mode=TwoWay}">
                <ComboBoxItem Content="Indoor"/>
                <ComboBoxItem Content="Outdoor"/>
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Results:" Width="80" VerticalAlignment="Center"/>
            <TextBox Width="50" Text="{Binding ResultCount, Mode=TwoWay}"/>
        </StackPanel>

        <StackPanel Grid.Row="6" Orientation="Vertical" VerticalAlignment="Bottom">
            <Button Content="Find Closest Locations" Margin="0,5" Padding="10,5"
                    Command="{Binding FindLocationsCommand}"/>
            <Button Content="Search with Filters" Margin="0,5" Padding="10,5"
                    Command="{Binding OpenFilterCommand}"/>
            <Button Content="Add New Location" Margin="0,5" Padding="10,5"
                    Command="{Binding OpenAddLocationCommand}"/>
        </StackPanel>
    </Grid>
</Window>
