<Window x:Class="NomadSpot.WPF.Views.AddReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Review" Height="560" Width="400"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <ScrollViewer>
        <StackPanel Margin="15">
            <TextBlock Text="Add Review" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

            <TextBlock Text="Author:"/>
            <TextBox Text="{Binding NewReviewAuthor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,10"/>

            <TextBlock Text="{Binding NewReviewRating, StringFormat='Rating: {0}'}"/>
            <Slider Minimum="1" Maximum="5" TickFrequency="1"
                    IsSnapToTickEnabled="True" Margin="0,0,0,10"
                    Value="{Binding NewReviewRating, Mode=TwoWay}"/>

            <TextBlock Text="{Binding NewReviewNoiseLevel, StringFormat='Noise Level: {0}'}"/>
            <Slider Minimum="1" Maximum="5" TickFrequency="1"
                    IsSnapToTickEnabled="True" Margin="0,0,0,10"
                    Value="{Binding NewReviewNoiseLevel, Mode=TwoWay}"/>

            <TextBlock Text="{Binding NewReviewWifiStrength, StringFormat='WiFi Strength: {0}  (0 = No WiFi)'}"/>
            <Slider Minimum="0" Maximum="5" TickFrequency="1"
                    IsSnapToTickEnabled="True" Margin="0,0,0,10"
                    Value="{Binding NewReviewWifiStrength, Mode=TwoWay}"/>

            <StackPanel Visibility="{Binding IsSelectedLocationIndoor, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding NewReviewComfortLevel, StringFormat='Comfort Level: {0}'}"/>
                <Slider Minimum="1" Maximum="5" TickFrequency="1"
                        IsSnapToTickEnabled="True" Margin="0,0,0,10"
                        Value="{Binding NewReviewComfortLevel, Mode=TwoWay}"/>

                <TextBlock Text="{Binding NewReviewPriceLevel, StringFormat='Price Level: {0}'}"/>
                <Slider Minimum="1" Maximum="5" TickFrequency="1"
                        IsSnapToTickEnabled="True" Margin="0,0,0,10"
                        Value="{Binding NewReviewPriceLevel, Mode=TwoWay}"/>
            </StackPanel>

            <StackPanel Visibility="{Binding IsSelectedLocationOutdoor, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding NewReviewCleanliness, StringFormat='Cleanliness: {0}'}"/>
                <Slider Minimum="1" Maximum="5" TickFrequency="1"
                        IsSnapToTickEnabled="True" Margin="0,0,0,10"
                        Value="{Binding NewReviewCleanliness, Mode=TwoWay}"/>

                <TextBlock Text="{Binding NewReviewCrowdedness, StringFormat='Crowdedness: {0}'}"/>
                <Slider Minimum="1" Maximum="5" TickFrequency="1"
                        IsSnapToTickEnabled="True" Margin="0,0,0,10"
                        Value="{Binding NewReviewCrowdedness, Mode=TwoWay}"/>
            </StackPanel>

            <TextBlock Text="Comment:"/>
            <TextBox Text="{Binding NewReviewComment, Mode=TwoWay}"
                     Height="80" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,15"/>

            <Button Content="Add Review" Padding="10,5"
                    Command="{Binding SaveNewReviewCommand}"/>
        </StackPanel>
    </ScrollViewer>
</Window>
