<Window x:Class="NomadSpot.WPF.Views.AddReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Review" Height="560" Width="400"
        WindowStartupLocation="CenterScreen">
    <ScrollViewer>
        <StackPanel Margin="15">
            <TextBlock Text="Add Review" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

            <TextBlock Text="Author:"/>
            <TextBox x:Name="AuthorBox" Margin="0,0,0,10"/>

            <TextBlock x:Name="RatingLabel" Text="Rating: 1"/>
            <Slider x:Name="RatingBox" Minimum="1" Maximum="5" TickFrequency="1"
                    IsSnapToTickEnabled="True" Value="1" Margin="0,0,0,10"
                    ValueChanged="RatingBox_ValueChanged"/>

            <TextBlock x:Name="NoiseLevelLabel" Text="Noise Level: 1"/>
            <Slider x:Name="NoiseLevelBox" Minimum="1" Maximum="5" TickFrequency="1"
                    IsSnapToTickEnabled="True" Value="1" Margin="0,0,0,10"
                    ValueChanged="NoiseLevelBox_ValueChanged"/>

            <TextBlock x:Name="WifiStrengthLabel" Text="WiFi Strength: 0  (0 = No WiFi)"/>
            <Slider x:Name="WifiStrengthBox" Minimum="0" Maximum="5" TickFrequency="1"
                    IsSnapToTickEnabled="True" Value="0" Margin="0,0,0,10"
                    ValueChanged="WifiStrengthBox_ValueChanged"/>

            <!-- Indoor-specific -->
            <StackPanel x:Name="IndoorPanel">
                <TextBlock x:Name="ComfortLevelLabel" Text="Comfort Level: 1"/>
                <Slider x:Name="ComfortLevelBox" Minimum="1" Maximum="5" TickFrequency="1"
                        IsSnapToTickEnabled="True" Value="1" Margin="0,0,0,10"
                        ValueChanged="ComfortLevelBox_ValueChanged"/>

                <TextBlock x:Name="PriceLevelLabel" Text="Price Level: 1"/>
                <Slider x:Name="PriceLevelBox" Minimum="1" Maximum="5" TickFrequency="1"
                        IsSnapToTickEnabled="True" Value="1" Margin="0,0,0,10"
                        ValueChanged="PriceLevelBox_ValueChanged"/>
            </StackPanel>

            <!-- Outdoor-specific -->
            <StackPanel x:Name="OutdoorPanel" Visibility="Collapsed">
                <TextBlock x:Name="CleanlinessLabel" Text="Cleanliness: 1"/>
                <Slider x:Name="CleanlinessBox" Minimum="1" Maximum="5" TickFrequency="1"
                        IsSnapToTickEnabled="True" Value="1" Margin="0,0,0,10"
                        ValueChanged="CleanlinessBox_ValueChanged"/>

                <TextBlock x:Name="CrowdednessLabel" Text="Crowdedness: 1"/>
                <Slider x:Name="CrowdednessBox" Minimum="1" Maximum="5" TickFrequency="1"
                        IsSnapToTickEnabled="True" Value="1" Margin="0,0,0,10"
                        ValueChanged="CrowdednessBox_ValueChanged"/>
            </StackPanel>

            <TextBlock Text="Comment:"/>
            <TextBox x:Name="CommentBox" Height="80" TextWrapping="Wrap"
                     AcceptsReturn="True" Margin="0,0,0,15"/>

            <Button Content="Add Review" Padding="10,5" Click="Add_Click"/>
        </StackPanel>
    </ScrollViewer>
</Window>
