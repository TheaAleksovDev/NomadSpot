<Window x:Class="NomadSpot.WPF.Views.AddLocationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Location" Height="620" Width="450"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <ScrollViewer>
        <StackPanel Margin="15">
            <TextBlock Text="Add New Location" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

            <TextBlock Text="Name:"/>
            <TextBox Text="{Binding NewName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,10"/>

            <TextBlock Text="Address:"/>
            <TextBox Text="{Binding NewAddress, Mode=TwoWay}"
                     Margin="0,0,0,10"/>

            <TextBlock Text="Latitude:"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBox Width="200" Text="{Binding NewLatitude, Mode=TwoWay}"/>
                <Button Content="Use My Location" Margin="10,0,0,0" Padding="8,3"
                        Command="{Binding UseMyLocationCommand}"/>
            </StackPanel>

            <TextBlock Text="Longitude:"/>
            <TextBox Text="{Binding NewLongitude, Mode=TwoWay}" Margin="0,0,0,10"/>

            <TextBlock Text="Type:"/>
            <ComboBox SelectedIndex="{Binding NewLocationTypeIndex, Mode=TwoWay}" Margin="0,0,0,10">
                <ComboBoxItem Content="Indoor"/>
                <ComboBoxItem Content="Outdoor"/>
            </ComboBox>

            <TextBlock Text="{Binding NewNoiseLevel, StringFormat='Noise Level: {0}'}"/>
            <Slider Minimum="1" Maximum="5" TickFrequency="1"
                    IsSnapToTickEnabled="True" Margin="0,0,0,10"
                    Value="{Binding NewNoiseLevel, Mode=TwoWay}"/>

            <TextBlock Text="{Binding NewWifiStrength, StringFormat='WiFi Strength: {0}  (0 = No WiFi)'}"/>
            <Slider Minimum="0" Maximum="5" TickFrequency="1"
                    IsSnapToTickEnabled="True" Margin="0,0,0,10"
                    Value="{Binding NewWifiStrength, Mode=TwoWay}"/>

            <CheckBox Content="Has Power Outlets" Margin="0,0,0,15"
                      IsChecked="{Binding NewHasPowerOutlets, Mode=TwoWay}"/>

            <StackPanel x:Name="IndoorPanel"
                        Visibility="{Binding NewIsIndoor, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Indoor Options:" FontWeight="Bold" Margin="0,10,0,5"/>
                <TextBlock Text="Indoor Type:"/>
                <ComboBox SelectedIndex="{Binding NewIndoorTypeIndex, Mode=TwoWay}" Margin="0,0,0,10">
                    <ComboBoxItem Content="Cafe"/>
                    <ComboBoxItem Content="Library"/>
                    <ComboBoxItem Content="CoworkingSpace"/>
                    <ComboBoxItem Content="University"/>
                    <ComboBoxItem Content="Other"/>
                </ComboBox>
                <TextBlock Text="{Binding NewComfortLevel, StringFormat='Comfort Level: {0}'}"/>
                <Slider Minimum="1" Maximum="5" TickFrequency="1"
                        IsSnapToTickEnabled="True" Margin="0,0,0,5"
                        Value="{Binding NewComfortLevel, Mode=TwoWay}"/>
                <TextBlock Text="{Binding NewPriceLevel, StringFormat='Price Level: {0}'}"/>
                <Slider Minimum="1" Maximum="5" TickFrequency="1"
                        IsSnapToTickEnabled="True" Margin="0,0,0,5"
                        Value="{Binding NewPriceLevel, Mode=TwoWay}"/>
                <TextBlock Text="Opening Hours:"/>
                <TextBox Text="{Binding NewOpeningHours, Mode=TwoWay}" Margin="0,0,0,10"/>
            </StackPanel>

            <StackPanel x:Name="OutdoorPanel"
                        Visibility="{Binding NewIsOutdoor, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Outdoor Options:" FontWeight="Bold" Margin="0,10,0,5"/>
                <TextBlock Text="Outdoor Type:"/>
                <ComboBox SelectedIndex="{Binding NewOutdoorTypeIndex, Mode=TwoWay}" Margin="0,0,0,10">
                    <ComboBoxItem Content="Park"/>
                    <ComboBoxItem Content="Bench"/>
                    <ComboBoxItem Content="SportsCourt"/>
                    <ComboBoxItem Content="Beach"/>
                    <ComboBoxItem Content="Garden"/>
                    <ComboBoxItem Content="Plaza"/>
                    <ComboBoxItem Content="Other"/>
                </ComboBox>
                <CheckBox Content="Has Benches"       Margin="0,0,0,5"
                          IsChecked="{Binding NewHasBenches, Mode=TwoWay}"/>
                <CheckBox Content="Has Shade"         Margin="0,0,0,5"
                          IsChecked="{Binding NewHasShade, Mode=TwoWay}"/>
                <CheckBox Content="Pet Friendly"      Margin="0,0,0,5"
                          IsChecked="{Binding NewPetFriendly, Mode=TwoWay}"/>
                <CheckBox Content="Has Public Toilet" Margin="0,0,0,5"
                          IsChecked="{Binding NewHasPublicToilet, Mode=TwoWay}"/>
                <CheckBox Content="Near Shops"        Margin="0,0,0,10"
                          IsChecked="{Binding NewNearShops, Mode=TwoWay}"/>
            </StackPanel>

            <Button Content="Add Location" Padding="10,5"
                    Command="{Binding SaveNewLocationCommand}"/>
        </StackPanel>
    </ScrollViewer>
</Window>
