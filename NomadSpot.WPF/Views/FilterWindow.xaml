<Window x:Class="NomadSpot.WPF.Views.FilterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Search Filters" Height="500" Width="400"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Search Filters" FontSize="18" 
                   FontWeight="Bold" Margin="0,0,0,15"/>

        <ScrollViewer x:Name="FiltersScrollViewer" Grid.Row="1"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="Search" Padding="15,5" Margin="0,0,10,0" Command="{Binding SearchCommand}"/>
            <Button Content="Clear"  Padding="15,5"                   Command="{Binding ClearCommand}"/>
        </StackPanel>
    </Grid>
</Window>