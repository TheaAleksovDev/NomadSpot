<Window x:Class="NomadSpot.WPF.Views.ReviewListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reviews" Height="500" Width="800"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="TitleBlock" Grid.Row="0" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
            <WrapPanel x:Name="ColumnsPanel" Grid.Row="1" Margin="0,0,0,8"/>
            <DataGrid x:Name="ReviewsGrid" Grid.Row="2"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionChanged="ReviewsGrid_SelectionChanged"/>
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="Filter" Width="80" Margin="0,0,8,0" Click="Filter_Click"/>
                <Button Content="Clear" Width="80" Margin="0,0,8,0" Click="Clear_Click"/>
                <Button Content="Close" Width="80" Click="Close_Click"/>
            </StackPanel>
        </Grid>

        <Border x:Name="DetailPanel" Grid.Column="1" Visibility="Collapsed"
                BorderBrush="#CCCCCC" BorderThickness="1" Margin="10,0,0,0"
                Padding="10" Width="220">
            <StackPanel>
                <TextBlock Text="Review Details" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                <ItemsControl x:Name="DetailItems">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,2,0,2">
                                <TextBlock Text="{Binding Key}" FontWeight="SemiBold" FontSize="11"/>
                                <TextBlock Text="{Binding Value}" TextWrapping="Wrap" FontSize="11"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="Close" Margin="0,10,0,0" Click="CloseDetail_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
