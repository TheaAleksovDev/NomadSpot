<Window x:Class="NomadSpot.WPF.Views.ReviewListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpf="clr-namespace:NomadSpot.WPF"
        Title="Reviews" Height="500" Width="800"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{Binding ReviewListTitle}"
                       FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

            <!-- Column selector -->
            <ItemsControl Grid.Row="1" ItemsSource="{Binding ReviewColumns}" Margin="0,0,0,8">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding Name}"
                                  IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                  Margin="0,0,8,0" VerticalAlignment="Center"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <DataGrid x:Name="ReviewsGrid" Grid.Row="2"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      ItemsSource="{Binding ReviewList.Items}"
                      SelectedItem="{Binding SelectedReview, Mode=TwoWay}"
                      wpf:DataGridColumnsBehavior.ColumnsSource="{Binding ReviewColumns}"/>
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="Filter" Width="80" Margin="0,0,8,0" Command="{Binding OpenReviewFilterCommand}"/>
                <Button Content="Clear"  Width="80" Margin="0,0,8,0"
                        Command="{Binding ClearReviewsCommand}"/>
                <Button Content="Close"  Width="80" Click="Close_Click"/>
            </StackPanel>
        </Grid>

        <Border Grid.Column="1"
                Visibility="{Binding HasSelectedReview, Converter={StaticResource BoolToVis}}"
                BorderBrush="#CCCCCC" BorderThickness="1" Margin="10,0,0,0"
                Padding="10" Width="220">
            <StackPanel>
                <TextBlock Text="Review Details" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                <ItemsControl ItemsSource="{Binding SelectedReviewDetails}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,2,0,2">
                                <TextBlock Text="{Binding Key}" FontWeight="SemiBold" FontSize="11"/>
                                <TextBlock Text="{Binding Value}" TextWrapping="Wrap" FontSize="11"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="Close" Margin="0,10,0,0" Command="{Binding CloseReviewDetailCommand}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
